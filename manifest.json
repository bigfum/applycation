{
  "manifest_version": 3,
  "name": "Applycation",
  "version": "0.1.0",
  "description": "Careful, local-first help with job application forms.",
  "permissions": ["activeTab", "scripting", "storage"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Open Applycation"
  }
}